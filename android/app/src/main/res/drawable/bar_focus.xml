<?xml version="1.0" encoding="utf-8"?>
<!-- The volume bar under the remote's focus: an outline, so the viewer sees that
     left and right move it. Nothing on a touchscreen, which never focuses it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#33f3f5f7" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
