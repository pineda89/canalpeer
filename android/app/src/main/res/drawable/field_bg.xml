<?xml version="1.0" encoding="utf-8"?>
<!-- The link field: panel with a line border, accent when focused (D-pad or touch). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/panel" /><corners android:radius="8dp" /><stroke android:width="1dp" android:color="@color/accent" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/panel" /><corners android:radius="8dp" /><stroke android:width="1dp" android:color="@color/line" /></shape>
    </item>
</selector>
