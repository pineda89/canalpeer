<?xml version="1.0" encoding="utf-8"?>
<!-- One recent channel: the row plays it, a long press copies its link, the ✕ removes it (Right from the row on a TV). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/recent_play"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/recent_row_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recent_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/outfit"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <!-- The id's ends: a long press (or holding OK) copies the whole link. -->
            <TextView
                android:id="@+id/recent_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/recent_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/outfit"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/recent_remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/recent_remove_bg"
        android:contentDescription="@string/recent_remove"
        android:fontFamily="@font/outfit"
        android:minWidth="0dp"
        android:padding="0dp"
        android:stateListAnimator="@null"
        android:text="✕"
        android:textColor="@color/muted"
        android:textSize="16sp" />
</LinearLayout>
