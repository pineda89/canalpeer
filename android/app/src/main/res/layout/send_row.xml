<?xml version="1.0" encoding="utf-8"?>
<!-- One TV: its name, its kind, and why it is off (a DLNA TV on a movie). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/recent_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/send_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit"
        android:textColor="@color/text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/send_kind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/send_reason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit"
        android:text="@string/send_movie_dlna"
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
