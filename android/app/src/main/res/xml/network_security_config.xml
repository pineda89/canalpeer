<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android only ships Let's Encrypt's root (canalpeer.com, the GitHub
         mirror) from 7.1.1; on 7.0 the update check could not verify them. -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>
    <!-- The Go core serves the stream on loopback over plain HTTP. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
